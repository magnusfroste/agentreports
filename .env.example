# A password of 20+ characters for the people who read the reports.
REPORTS_PASSWORD=
# One key per agent installation, 32+ characters each: name:key,name:key
# Make one with: openssl rand -hex 32
MCP_KEYS=hermes:
SITE_TITLE=Reports
SITE_SUBTITLE=
REPORTS_LANG=en
PUBLIC_URL=https://reports.example.com
# Behind Cloudflare: CF-Connecting-IP. Only set it when every request comes through that proxy.
TRUSTED_PROXY_HEADER=
# Names shown instead of the key names: name=Shown name,name2=Other
AGENT_NAMES=
# on (default): agents get /static/report.css and the tool report_style so reports look like the site
REPORT_STYLE=on
# on (default): agents may change logo, fonts and colours over MCP, as versions people can roll back at /brand
AGENT_BRANDING=on
# Optional folder with your logo, fonts and colours (see README), mounted read-only
BRAND_DIR=
# Optional read-only folder served to signed-in readers, e.g. the documents reports link to
FILES_DIR=
FILES_ROUTE=/files
# Largest report accepted, in bytes (default 10 MB)
MAX_REPORT_BYTES=10485760
